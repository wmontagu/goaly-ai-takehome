# Anthropic API key. Required unless each tester pastes their own key into the UI.
ANTHROPIC_API_KEY=

# Only for a key that isn't scoped to a workspace: the workspace to bill.
# Applies to the server's key, never to a key pasted in the test drawer.
ANTHROPIC_WORKSPACE_ID=

# Call ① UNDERSTAND (classify + extract, every turn) and call ⑤ RESPOND (reply + email summary).
MODEL_UNDERSTAND=claude-haiku-5-5
MODEL_RESPOND=claude-sonnet-5-5

# Deepgram key for Call mode's speech-to-text. Optional: without it, Call mode
# falls back to the browser's own recognition (Chrome/Edge only).
DEEPGRAM_API_KEY=

# Email sender implementation. Only "simulated" ships (writes to the in-app outbox).
EMAIL_PROVIDER=simulated

# Fixed "today" (YYYY-MM-DD) for deadline math. Leave blank to use the real date.
# 2026-03-01 fits every fixture: after all claims' created dates (latest is
# 2026-03-01) and before both appeal deadlines (2026-03-18, 2026-04-15).
SOP_TODAY=2026-03-01
